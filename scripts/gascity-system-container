#!/bin/sh
# Interactive system Gas City demo.
#
# Usage: scripts/gascity-system-container
#        scripts/gascity-system-container --container
#
# Build and boot examples/gascity/bright-lights-system.scm, a fresh,
# ephemeral machine-wide "bright-lights" city, with the Gas City supervisor
# running as the "gascity" account.  By default it builds and runs a system
# container (`sudo env PATH="$PATH" guix system container --network'), the
# counterpart of `scripts/gascity-home-container': a 65536-uid/gid range is mapped into the
# container's user namespace, which only root may do, so the container is
# built and started through sudo.  Use `--vm' for a rootless QEMU VM
# (`guix system vm --no-graphic') instead.
#
# The wrapper:
#
#   * in container mode (the default) exposes a dedicated Claude Code API
#     key read-only: the file named by GASCITY_ANTHROPIC_API_KEY_FILE (a
#     Console API key created for this city alone, with a spend limit) is
#     staged in a private temporary directory exposed as /mnt/claude-ro (a
#     bind mount), and the example installs it into the service user's home
#     at boot.  Your own ~/.claude/.credentials.json and ~/.claude.json are
#     never shared: the agents run with --dangerously-skip-permissions and can
#     read everything their user can;
#   * in VM mode (`--vm') shares nothing: reading files over QEMU's 9p virtfs
#     hangs the guest here, so the VM boots unauthenticated and you run
#     `claude login' inside it;
#   * prints a banner with how to log in and the commands that matter, then
#     boots the VM and forwards the console;
#   * passes QEMU 2 GiB of RAM (the 128 MiB default OOM-kills `gc' during
#     genesis) and, on aarch64, QEMU's `-M virt -cpu max' (without which the
#     aarch64 emulator has no default machine).
#
# Containers drop the serial `agetty' (no /dev/tty*), so interact with
# `sudo env PATH="$PATH" guix container exec' (see the banner) instead of a
# login prompt.

set -eu

script_dir=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
root=$(CDPATH= cd -- "$script_dir/.." && pwd)
example="$root/examples/gascity/bright-lights-system.scm"

usage() {
    cat <<'USAGE'
Usage: scripts/gascity-system-container [--vm]

Boot examples/gascity/bright-lights-system.scm, a fresh, ephemeral
machine-wide "bright-lights" city, with the Gas City supervisor running as
the "gascity" account.

Options:
  -h, --help        show this help and exit
  --vm              boot a rootless QEMU VM (`guix system vm --no-graphic')
                    instead of the default system container
  --container       accepted for compatibility; the container is the default

Examples:
  scripts/gascity-system-container
  scripts/gascity-system-container --vm

By default the demo builds and runs a system container with
`sudo env PATH="$PATH" guix system container --network' (needs root: a system
container maps a 65536-uid/gid range into its user namespace).  Interact with
it through `sudo env PATH="$PATH" guix container exec' (see the banner).
With `--vm' it boots a rootless
QEMU VM whose console is the serial port; log in at the `bright-lights
login:' prompt as `root' (no password on a fresh Guix System).

In container mode the file named by GASCITY_ANTHROPIC_API_KEY_FILE, a
dedicated Console API key with a spend limit, is exposed read-only and
installed into the service user's home at boot.  Your own Claude Code login
(~/.claude/.credentials.json, ~/.claude.json) is never shared.  Without the
variable, and in VM mode, the demo boots unauthenticated: run `claude login'
as the gascity user with an account of its own.
USAGE
}

require_guix() {
    command -v guix >/dev/null 2>&1 || {
        echo "FAIL: guix is not on PATH" >&2
        exit 1
    }
}

# Container is the default; `--vm' selects the rootless QEMU VM.
container_mode=yes

while [ $# -gt 0 ]; do
    case "$1" in
        -h|--help)
            usage
            exit 0
            ;;
        --vm)
            container_mode=no
            shift
            ;;
        --container)
            container_mode=yes
            shift
            ;;
        *)
            echo "unknown argument: $1" >&2
            usage >&2
            exit 2
            ;;
    esac
done

[ -f "$example" ] || {
    echo "FAIL: $example not found" >&2
    exit 1
}

require_guix

# Stage the dedicated API key for the container, which shares it through a
# bind mount.  `--expose' exports a *directory*, so the key is staged in a
# private temporary directory exposed as /mnt/claude-ro.  Only this key is
# staged: the operator's own Claude Code login never reaches the agents.
#
# The VM (`--vm') deliberately shares nothing: reading any file over QEMU's
# 9p virtfs mount hangs the guest before it reaches a login prompt, so the VM
# boots unauthenticated and the user runs `claude login' inside it.
if [ "$container_mode" = yes ]; then
    staging=$(mktemp -d "${TMPDIR:-/tmp}/gascity-claude.XXXXXX")
    chmod 700 "$staging"
    cleanup() {
        rm -rf "$staging"
    }
    trap cleanup EXIT INT TERM

    key_file=${GASCITY_ANTHROPIC_API_KEY_FILE:-}
    if [ -n "$key_file" ] && [ -f "$key_file" ]; then
        cp "$key_file" "$staging/anthropic-api-key"
        chmod 600 "$staging/anthropic-api-key"
    else
        echo "note: GASCITY_ANTHROPIC_API_KEY_FILE is not set (or not a file)." >&2
        echo "      The demo boots, but claude is not authenticated; create a" >&2
        echo "      Console API key for this city with a spend limit, or run" >&2
        echo "      'claude login' as the gascity user with an account of its own." >&2
    fi

    # `set --' keeps the exposed source a separate argument even when a path
    # contains spaces.
    set -- --expose="$staging=/mnt/claude-ro"
else
    set --
    echo "note: --vm boots unauthenticated (no API key is shared); run" >&2
    echo "      'claude login' as the gascity user inside the VM, or use the" >&2
    echo "      default container with GASCITY_ANTHROPIC_API_KEY_FILE." >&2
fi

banner() {
    printf '\n'
    printf 'Gas City bright-lights demo (ephemeral %s)\n' "$1"
    printf '\n'
    printf 'The city is fresh and ephemeral: it lives only in this image.  The\n'
    printf 'agents use the dedicated API key from GASCITY_ANTHROPIC_API_KEY_FILE,\n'
    printf 'never your own Claude Code login.\n'
    printf '\n'
    if [ "$container_mode" = yes ]; then
        printf 'Log in with:\n'
        printf '    sudo env PATH="$PATH" guix container exec $(cat /tmp/bright-lights.pid) /run/current-system/profile/bin/bash --login\n'
    else
        printf 'Log in on the serial console as root (no password):\n'
        printf '    bright-lights login: root\n'
    fi
    printf '\n'
    printf 'The declared rig /var/lib/gascity/my-project is initialized for you\n'
    printf '(as the gascity user) when the city starts; do NOT run `gc rig add`\n'
    printf 'as root -- that would create root-owned beads files the gascity\n'
    printf 'supervisor cannot read.\n'
    printf '\n'
    printf 'Then:\n'
    printf '    export GC_HOME=/var/lib/gascity/.gc\n'
    printf '    cd /var/lib/gascity/bright-lights\n'
    printf '    gc status\n'
    printf '    gc sling my-project/claude "your task"\n'
    printf '    gc session list\n'
    printf '\n'
}

echo "building examples/gascity/bright-lights-system.scm..." >&2

if [ "$container_mode" = yes ]; then
    banner "system container"
    # A system container maps a 65536-uid/gid range into its user namespace,
    # which the kernel only allows for root (Guix does not use newuidmap), so
    # build and run it with sudo.  `--network' shares the host network; Guix
    # then replaces the OS's static networking with a no-op (see
    # `containerized-operating-system').
    launcher=$(sudo env PATH="$PATH" guix system container -L "$root/modules" --network \
                    "$@" "$example")
    sudo "$launcher" --pid-file=/tmp/bright-lights.pid
else
    banner "VM"
    launcher=$(guix system vm -L "$root/modules" --no-graphic \
                    "$@" "$example")
    # On aarch64 QEMU's emulator has no default machine; the launcher forwards
    # extra arguments to QEMU.  The default VM memory (QEMU's 128 MiB) is too
    # small for the running city (Dolt plus the supervisor and its `gc'
    # helpers), so the guest OOM-kills `gc' during genesis; give it 2 GiB, the
    # same as the system smoke test.  On x86_64 the machine and CPU defaults
    # are fine.
    qemu_args="-m 2048"
    case "$(uname -m)" in
        aarch64*) qemu_args="-M virt -cpu max $qemu_args" ;;
    esac
    # Deliberate word splitting: qemu_args is a list of QEMU arguments.
    # shellcheck disable=SC2086
    "$launcher" $qemu_args
fi
